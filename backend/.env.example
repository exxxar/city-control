# App
APP_NAME="City Under Control"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_me_to_a_very_long_random_string

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=city_under_control

# Redis (для Celery и кэша)
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=eu

# Storage (Local or S3)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=